# Multi-stage build for Next.js with output: standalone.
#
# The previous one-stage Dockerfile ran `next start` which is
# incompatible with `output: standalone` in next.config.ts. Next.js
# warns and degrades when this mismatch happens, manifesting as stale
# server-rendered pages even after a successful rebuild.
#
# The fix per Next.js docs: copy .next/standalone + .next/static (and
# public/ if present) into the runtime image, then `node server.js`.

FROM node:22-slim AS builder

WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm install
COPY . .
# Feature flag for the v2 "Living Ledger" dashboard. NEXT_PUBLIC_* values are
# inlined at build time, so it must be present here. Default off → v1 dashboard.
ARG NEXT_PUBLIC_DASHBOARD_V2=false
ENV NEXT_PUBLIC_DASHBOARD_V2=$NEXT_PUBLIC_DASHBOARD_V2
RUN npm run build


FROM node:22-slim AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

# Standalone server bundle (includes a trimmed node_modules)
COPY --from=builder /app/.next/standalone ./
# Static assets must be co-located with the standalone server
COPY --from=builder /app/.next/static ./.next/static

EXPOSE 3000

# server.js is generated by next build when output: standalone is set
CMD ["node", "server.js"]
