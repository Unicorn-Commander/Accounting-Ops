# Core deployment
COMPOSE_PROJECT_NAME=accounting_ops
HEADSCALE_INTERFACE=tailscale0
# Set this to midboy1's Tailscale IP for deployment; default loopback is for local dev.
HEADSCALE_BIND_IP=127.0.0.1
APP_HOST=0.0.0.0
APP_PORT=8000
WEB_PORT=3000
PUBLIC_BASE_URL=https://accounting.magicunicorn.dev
TENANT_ID=

# Postgres 16
POSTGRES_DB=accounting_ops
POSTGRES_USER=accounting_ops
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+asyncpg://accounting_ops:${POSTGRES_PASSWORD}@postgres:5432/accounting_ops

# Garage single-node S3-compatible object storage
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_S3_ENDPOINT=http://garage:3900
GARAGE_BUCKET_PREFIX=accounting-ops

# Keycloak uchub realm
KEYCLOAK_BASE_URL=https://auth.unicorncommander.ai
KEYCLOAK_REALM=uchub
KEYCLOAK_REALM_URL=https://auth.unicorncommander.ai/realms/uchub
KEYCLOAK_CLIENT_ID=accounting-ops-app
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
NEXTAUTH_URL=https://accounting.magicunicorn.dev
NEXTAUTH_SECRET=

# Brigade/FalkorDB connection point only; Brigade integration is Phase 1+
FALKORDB_HOST=192.168.10.10
FALKORDB_PORT=6379

# Runtime router endpoints and keys
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
QWEN_LOCAL_URL=http://midboy1:8000/v1
QWEN_VLM_URL=http://midboy1:8087/v1

# Observability: set to centerdeep OTLP endpoint for deployment
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=accounting-ops

# Traefik
TRAEFIK_NETWORK=traefik
ACCOUNTING_DOMAIN=accounting.magicunicorn.dev
