# Core deployment
COMPOSE_PROJECT_NAME=accounting_ops
HEADSCALE_INTERFACE=tailscale0
# Host IP the published container ports bind to. Default loopback keeps the
# stack private (reverse-proxy in front); set to the host's LAN/VPN IP to expose.
HEADSCALE_BIND_IP=127.0.0.1
APP_HOST=0.0.0.0
APP_PORT=8000
WEB_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
TENANT_ID=

# Postgres 16
POSTGRES_DB=accounting_ops
# POSTGRES_USER/PASSWORD = the table-OWNING role. Postgres creates it on first
# boot; it owns every schema/table and is used ONLY by migrations + workspace
# provisioning (NOT by the running app).
POSTGRES_USER=accounting_ops
POSTGRES_PASSWORD=

# --- DB roles (audit C3: DB-enforced isolation + ledger immutability) --------
# The app/web/cpa-export RUN as a LEAST-PRIVILEGE role (accounting_ops_app):
#   - SELECT/INSERT broadly; UPDATE only on mutable tables; DELETE only on
#     category_override. CANNOT UPDATE/DELETE/TRUNCATE or DISABLE TRIGGER on the
#     append-only ledger tables. Subject to Row-Level Security.
# The role is CREATED by the migrations (LOGIN, NO password); set its password
# out-of-band ONCE per deployment:
#   psql -U accounting_ops -d accounting_ops \
#     -c "ALTER ROLE accounting_ops_app PASSWORD '<choose-a-strong-password>';"
# Then point the runtime app at it:
DATABASE_URL=postgresql+asyncpg://accounting_ops_app:${APP_DB_PASSWORD}@postgres:5432/accounting_ops
# Runtime role password (referenced above). Keep out of version control.
APP_DB_PASSWORD=
# Owner URL used ONLY by migrations + provisioning (alembic, provision_workspace).
# MUST be the owning role. If unset, falls back to DATABASE_URL (single-role).
ADMIN_DATABASE_URL=postgresql+asyncpg://accounting_ops:${POSTGRES_PASSWORD}@postgres:5432/accounting_ops

# Garage single-node S3-compatible object storage
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=
GARAGE_S3_ENDPOINT=http://garage:3900
GARAGE_BUCKET_PREFIX=accounting-ops
# S3 access key + secret for the document-upload path (drag-in receipts/docs).
# Create with: garage key create accounting-ops-app ; garage bucket allow \
#   --read --write accounting-ops --key accounting-ops-app
# Leave blank to disable uploads (endpoint returns 503, never silently drops).
GARAGE_S3_ACCESS_KEY=
GARAGE_S3_SECRET_KEY=
GARAGE_S3_REGION=garage
# Max single-document upload size in bytes (default 25 MB).
DOCUMENT_UPLOAD_MAX_BYTES=26214400

# ---- Edition + auth mode (open-core Community Edition carve-out) ------------
# AO_EDITION: "enterprise" (default — full suite/Brigade federation surface) or
#   "community" (self-host: enterprise routers unmounted, enterprise nav hidden).
# AO_AUTH_MODE: "keycloak" (default — uchub SSO) or "local" (single self-host
#   admin, no Keycloak). BOTH the backend (app/) and web (web/) read these.
AO_EDITION=enterprise
AO_AUTH_MODE=keycloak
# Local self-host admin login (only used when AO_AUTH_MODE=local). Generate the
# password hash with: python scripts/gen_local_admin_hash.py
# AO_LOCAL_AUTH_SECRET is the HS256 secret the web signs the bearer with and the
# backend validates against — set it to a long random string, SAME value in both.
AO_LOCAL_ADMIN_EMAIL=
AO_LOCAL_ADMIN_UC_UID=admin
AO_LOCAL_ADMIN_PASSWORD_HASH=
AO_LOCAL_AUTH_SECRET=

# Keycloak realm (ONLY used when AO_AUTH_MODE=keycloak — enterprise SSO).
# Community self-host uses AO_AUTH_MODE=local and can leave these blank.
KEYCLOAK_BASE_URL=https://sso.example.com
KEYCLOAK_REALM=accounting-ops
KEYCLOAK_REALM_URL=https://sso.example.com/realms/accounting-ops
KEYCLOAK_CLIENT_ID=accounting-ops-app
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Optional Brigade/FalkorDB agent-memory projection (best-effort; absence is a
# no-op — the app never blocks on it). Point at your FalkorDB service.
FALKORDB_HOST=falkordb
FALKORDB_PORT=6379

# ---- BYO model endpoints ------------------------------------------------
# Self-host default = the bundled `ollama` service (docker-compose.selfhost.yml).
# Pull a vision model first, e.g.:  docker compose exec ollama ollama pull qwen2.5vl:7b
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
QWEN_LOCAL_URL=http://ollama:11434/v1
QWEN_VLM_URL=http://ollama:11434/v1
# Categorizer / receipt-VLM endpoint (OpenAI-compatible). Choose a VISION model.
LLM_ENDPOINT_URL=http://ollama:11434/v1
LLM_MODEL=qwen2.5vl:7b
LLM_API_KEY=

# ---- Categorizer model routing (SEPARATE from the vision knobs above) -------
# Categorization is pure TEXT classification, so it can route to a text model
# while LLM_* above stays pinned to an image-capable model for receipt OCR.
# All four primaries are OPTIONAL -- unset, they inherit the LLM_* values above.
# NOTE the _LLM_ infix on the primaries; the fallback knobs do not have it.
CATEGORIZER_LLM_ENDPOINT_URL=
CATEGORIZER_LLM_MODEL=
CATEGORIZER_LLM_API_KEY=
CATEGORIZER_LLM_TIMEOUT_S=
# Optional frontier escalation. BLANK = OFF (no second call, no cloud spend).
# When set, the primary is escalated to this model if it abstains
# ("Uncategorized") or returns confidence below the threshold.
CATEGORIZER_FALLBACK_MODEL=
CATEGORIZER_FALLBACK_ENDPOINT_URL=
CATEGORIZER_FALLBACK_API_KEY=
CATEGORIZER_ESCALATE_BELOW_CONFIDENCE=0.60
# Optional traditional-OCR cross-check service. Blank = disabled (VLM-only).
OCR_BBOX_SERVICE_URL=

# ---- LLM resilience: User-Agent + failover ------------------------------
# User-Agent sent on EVERY outbound LLM request. Default:
#   AccountingOps/<version> (+https://accounting-ops.unicorncommander.ai)
# Set this only if a CDN/WAF in front of your gateway starts blocking the
# default. The OpenAI SDK's own UA ("OpenAI/Python x.y.z") is blocked by
# Cloudflare with 403 + "error code: 1010", which is why the app never sends
# it. (AO_CHAT_USER_AGENT is the legacy name and is still honored.)
AO_LLM_USER_AGENT=
#
# Cloud FALLBACK rung. Blank LLM_FALLBACK_BASE_URL = failover DISABLED, and the
# app behaves exactly as it did before failover existed (single provider, fail
# on error). When set, a request that fails against the primary endpoint above
# is retried ONCE against this one.
#
# Fails over on:  connection error, timeout, 408/425/429, 5xx, and the
#                 Cloudflare block signature on 403.
# Does NOT fail over on: 400/401/402/404/405/409/422 — those are app bugs, and
#                 retrying them on a paid provider just burns spend.
# Bounded: at most ONE fallback attempt per request. Every failover is logged
# at WARNING (logger "acctops.llm") and stamped on the OTel span as
# llm.failover / llm.failover.reason.
#
# LLM_FALLBACK_MODEL is optional; blank = reuse the primary's model name.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# --- LOCAL-first chat tier (sovereign qwen) -----------------------------
# Routes chat/CFO/specialist inference DIRECTLY at the llama-router. Sits ahead
# of the gateway + OpenRouter branches, so a local turn never falls through to
# OpenRouter — $0, no metering. Blank base_url ⇒ tier disabled (no-op).
#   BASE_URL → the llama-router (OpenAI-compatible), e.g. the self-hosted dev box.
#   MODEL    → the EXACT id the router serves; llama-swap suffixes them, so it's
#              "Qwen3.6-35B-A3B-p40" (text), NOT bare "Qwen3.6-35B-A3B" (404s).
#   API_KEY  → blank (the router needs none).
AO_CHAT_LOCAL_BASE_URL=
AO_CHAT_LOCAL_MODEL=Qwen3.6-35B-A3B-p40
AO_CHAT_LOCAL_API_KEY=
# INSTANCE-WIDE default: 1 ⇒ EVERY workspace is local-first without the
# per-workspace EngagementPolicy.prefer_local_inference flag. The one knob for a
# fully self-hosted, local-only box — also permanently closes the OpenRouter
# fall-through for every turn. Leave blank for per-workspace opt-in only.
AO_CHAT_LOCAL_DEFAULT=
# AUTO-ESCALATE hard personas: 1 ⇒ the deep-reasoning personas (CFO + tax
# specialists/researchers) use the cloud tiers even on routine turns, while
# operational personas (setup, product guide) stay on free local qwen —
# "local for routine, frontier cloud for the hard reasoning". Escalated turns
# use the workspace's BYOK key when present, else the platform/gateway key — so
# STORE THE WORKSPACE'S BYOK FIRST, or the hard turns bill the platform key.
AO_CHAT_ESCALATE_HARD_PERSONAS=

# --- Chat / CFO / specialist inference gateway (UC LiteLLM) --------------
# Routes frontier chat inference through the metered UC gateway instead of
# OpenRouter-direct. See docs/INFERENCE-AND-BILLING.md + agents/chat/inference_config.py.
#
# DEFAULT OFF: with AO_ROUTE_CHAT_THROUGH_GATEWAY unset the chat path is
# byte-identical to today (OpenRouter-direct on the shared key = unmetered).
# PRODUCTION (unicorncommander.ai) MUST set the three below to stop that leak.
#
# 1 / true / yes / on  → route chat through the gateway. Resolver precedence:
#   per-workspace BYOK > per-workspace virtual key > LLM_PLATFORM_VIRTUAL_KEY > OpenRouter.
AO_ROUTE_CHAT_THROUGH_GATEWAY=
# Gateway base URL. The code default is the compose-internal http://litellm:4000;
# point at your gateway's DIRECT address (internal LLM traffic goes direct /
# Tailscale, not through Cloudflare). llm.unicorncommander.ai is retired.
LLM_GATEWAY_BASE_URL=http://litellm:4000
# SCOPED admin key (NOT the gateway master) used to mint per-workspace virtual
# keys. Without it, minting is skipped and every workspace falls back to the
# platform key below. Get this from the gateway operator.
LLM_GATEWAY_ADMIN_KEY=
# CATCH-ALL platform virtual key. CRITICAL: set this so a turn from a workspace
# with no BYOK and no resolved org still meters through the gateway instead of
# escaping to the unbilled OpenRouter key. Blank ⇒ such turns fall through to
# OpenRouter (the cost leak persists).
LLM_PLATFORM_VIRTUAL_KEY=
# Smart inference gate: when ON, hosted chat requires BYOK, an entitlement
# claim, OR a stored per-workspace virtual key (comped access). ⚠️ The
# entitlement claim is emitted by NOTHING today — flipping this on blocks
# every non-BYOK, non-comped workspace. Default OFF.
AO_SMART_GATE_ENABLED=

# Tax Knowledge embedding backend (see app/exports/tax_knowledge_embed.py)
# Priority: EMBED_BASE_URL → INFINITY_BASE_URL → OPENROUTER_API_KEY
#
# Self-hosted Infinity (default, profile=embeddings):
#   Start:  docker compose --profile embeddings up -d infinity
#   Model:  BAAI/bge-large-en-v1.5  (1024-dim, ~1.3 GB, Tesla P40 or CPU)
#   Alt:    mixedbread-ai/mxbai-embed-large-v1 (also 1024-dim)
EMBED_BASE_URL=http://infinity:7997
EMBED_MODEL=BAAI/bge-large-en-v1.5
# Infinity port on the host (default 7997).  Change if occupied.
INFINITY_PORT=7997
# Infinity device: 'cuda' for a CUDA GPU, 'cpu' for dev/no-GPU hosts.
INFINITY_DEVICE=cpu
# INFINITY_BASE_URL — optional second pointer (e.g. a remote Infinity host)
# INFINITY_BASE_URL=http://infinity-host:7997
#
# OpenRouter cloud fallback (used when EMBED_BASE_URL is unset or points at OpenRouter):
# OPENROUTER_API_KEY=sk-or-...

# Observability: set to your OTLP collector endpoint (blank = disabled).
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=accounting-ops

# Traefik
TRAEFIK_NETWORK=traefik
ACCOUNTING_DOMAIN=accounting.example.com

# --- Outbound mail (optional) -------------------------------------------
# Read by app/mailer.py AND scripts/drain_email_outbox.py.
# Absence of SMTP_HOST = queue-only mode (rows pile up in email_outbox).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM=Accounting-Ops <noreply@example.com>
SMTP_USE_TLS=true
SMTP_TIMEOUT_S=10

# --- eBay Finances connector (optional) ---------------------------------
# Register an app at developer.ebay.com/my/keys with the sell.finances scope
# and fill in the keys below to reconcile eBay payouts into the journal.
#
# Register the OAuth callback URL in the eBay developer dashboard against
# the RuName referenced by EBAY_REDIRECT_URI:
#   https://<your-domain>/api/connectors/ebay/oauth/callback
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
# RuName (the eBay redirect label from your developer dashboard), NOT the URL itself.
# eBay's quirk: redirect_uri in the OAuth call is the RuName label; eBay
# looks up the actual https:// destination from its dashboard mapping.
EBAY_REDIRECT_URI=
# production | sandbox (default production)
EBAY_ENVIRONMENT=production
# Sync interval in seconds (default 3600 = hourly).
EBAY_SYNC_INTERVAL_S=3600
# Optional: lock the sync worker to one workspace UUID. Unset = all workspaces.
EBAY_SYNC_WORKSPACE=
EBAY_SYNC_LOG_LEVEL=INFO

# --- Stripe API connector (optional) ------------------------------------
# NO env vars are required for the API key itself — paste the restricted key
# at /connectors and it's stored encrypted in public.tenant_credentials
# (connector='stripe_api_key').
#
# Webhook URL to register at dashboard.stripe.com/webhooks:
#   https://<your-domain>/api/connectors/stripe/webhook
#
# After registering, Stripe gives a signing secret (whsec_...). Paste it
# via the /connectors UI ("Add webhook secret" button) — it lands in the
# same encrypted credential blob alongside the API key.
#
# Sync interval in seconds (default 3600 = hourly).
STRIPE_SYNC_INTERVAL_S=3600
# Optional: lock the sync worker to one workspace UUID. Unset = all workspaces.
STRIPE_SYNC_WORKSPACE=
STRIPE_SYNC_LOG_LEVEL=INFO

# --- Mail drainer (drains public.email_outbox) --------------------------
# Loop interval in seconds. Default 60 — invites land within ~1 min.
MAIL_DRAINER_INTERVAL_S=60
# Retries before flipping a row to terminal status='failed'.
MAIL_DRAINER_MAX_ATTEMPTS=5
# Rows claimed per pass (per drainer instance).
MAIL_DRAINER_BATCH_LIMIT=25

# --- Erasure purge runner (deferred data-rights purges) ------------------
# Kill switch for scripts/purge_due_erasures.py / the "erasure-purger"
# compose profile. DEFAULT OFF: the runner refuses to execute any deferred
# ledger purge until this is explicitly "true". Also requires
# ADMIN_DATABASE_URL (above) — the runtime role cannot purge the ledger.
AO_ERASURE_PURGE_ENABLED=false
# Sweep interval in seconds (default 3600 = hourly).
ERASURE_PURGE_INTERVAL_S=3600

# --- Sentinel cadence ----------------------------------------------------
# The daemon's POLLING interval — how often Sentinel LOOKS for due work.
# It is NOT how often a check runs: each check obeys its own cadence
# (agents/sentinel/config.py CHECK_CADENCE: daily/weekly/monthly) and each
# workspace obeys sentinel_config.check_interval_minutes, both enforced in
# agents/sentinel/cadence.py. Lowering this makes Sentinel more responsive
# WITHOUT increasing how often any individual check fires.
SENTINEL_DEFAULT_INTERVAL_MINUTES=360
# Minutes a check may fire EARLY so its cadence stays anchored to a stable
# wall-clock rhythm instead of drifting later on every coarse poll tick.
SENTINEL_CADENCE_GRACE_MINUTES=30

# --- Regulatory feeds ----------------------------------------------------
# Source URLs. Defaults are the verified-working endpoints; override only to
# retarget. NOTE: irs.gov no longer publishes ANY RSS feed (every historical
# feed path 404s), which is why the IRS regulatory source is the Federal
# Register API and the news source is an HTML scrape of the newsroom index.
REGULATORY_IRS_FR_URL=
REGULATORY_IRS_NEWSROOM_URL=
REGULATORY_SCDOR_URL=
# A feed raises a Sentinel finding once it has failed this many times in a row
# AND gone this many hours without a success. Both must be true, so a single
# transient network blip does not page anyone.
REGULATORY_FEED_STALE_HOURS=48
REGULATORY_FEED_STALE_FAILURES=3

# --- Rate limiting (app/rate_limit.py) -----------------------------------
# Per-tenant AND per-principal token buckets, tiered by request cost.
# Default ON, except Community Edition (AO_EDITION=community) where it
# defaults OFF — a single-tenant self-hoster has no neighbours to protect.
# An explicit value here always wins over that edition default.
AO_RATE_LIMIT_ENABLED=
# Per-principal ceilings, requests/minute, by cost tier.
AO_RATE_LIMIT_CHEAP_PER_MIN=300
AO_RATE_LIMIT_WRITE_PER_MIN=90
AO_RATE_LIMIT_EXPENSIVE_PER_MIN=15
AO_RATE_LIMIT_WEBHOOK_PER_MIN=600
# A whole workspace's ceiling = per-principal limit x this factor. Stops one
# tenant starving the others no matter how many users/tokens it spreads over.
AO_RATE_LIMIT_TENANT_FACTOR=4.0
# Bucket capacity multiplier — absorbs a page firing several parallel reads
# without raising the sustained rate.
AO_RATE_LIMIT_BURST=2.0
# Honor X-Forwarded-For for the IP fallback (unauthenticated routes only).
# We sit behind Traefik, so default ON.
AO_RATE_LIMIT_TRUST_FORWARDED=true
# OPTIONAL shared backend. Unset = in-process buckets, which are PER-REPLICA.
# There is no Redis/valkey in the compose stack today and `app` runs a single
# replica, so in-process is exact. If you scale the app out, set this AND
# install the extra (pip install accounting-ops[ratelimit]) so every replica
# shares one ceiling.
AO_RATE_LIMIT_REDIS_URL=

# ---- Trusted machine-to-machine callers (Keycloak client-credentials) ----
# Space-separated Keycloak client ids (azp) allowed on the federation reads
# (tax-planning-ops: P&L + tax-document extractions) and on the quotes seam
# (customer-ops ONLY: POST /api/workspaces/{wid}/entities/{eid}/quotes/accepted,
# which creates DRAFT invoices/schedules/partner bills — never posts).
# Tokens must still carry aud=ACCEPTED_AUDIENCE. Empty = no M2M callers.
# ACCTOPS_TRUSTED_M2M_CALLERS=customer-ops tax-planning-ops
